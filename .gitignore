# Secrets: every stack reads them from a .env; only .env.example is committed
.env
.env.*
!.env.example
secrets.yml
*.key
*.pem

# Archives: config dumps (router, firewall, PVE) can carry credentials
*.tgz
*.tar.gz
*.tar.zst
*.zip

# Local backups, logs, editor cruft
*.bak
*.bak-*
*.save
*.log
.DS_Store

# legacy/2025-pi-cluster: Docker volumes of the old Pi stack
legacy/2025-pi-cluster/configs/raspberrypi/*/data/
legacy/2025-pi-cluster/configs/raspberrypi/portainer-data/
legacy/2025-pi-cluster/configs/raspberrypi/paperless/
