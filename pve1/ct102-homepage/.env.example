# Homepage secrets, referenced from config/*.yaml as {{HOMEPAGE_VAR_NAME}}.
# Copy to .env (chmod 600). Never inline a key in services.yaml.

# arr-stack (CT 100) - each app's Settings > General > API Key
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
HOMEPAGE_VAR_SABNZBD_KEY=
HOMEPAGE_VAR_SEERR_KEY=
# Jellyfin: Dashboard > Advanced > API Keys
HOMEPAGE_VAR_JELLYFIN_KEY=
# qBittorrent WebUI password (user "admin")
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=
# gluetun control-server key, limited to GET /v1/publicip/ip
HOMEPAGE_VAR_GLUETUN_KEY=

# services (CT 103)
HOMEPAGE_VAR_PAPERLESS_TOKEN=
HOMEPAGE_VAR_JELLYSTAT_KEY=

# Proxmox: read-only API token (user homepage@pve, role PVEAuditor)
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=
